# Copy this file to ".env" and fill in the values.

# Discord Developer Portal → your app → OAuth2
VITE_DISCORD_CLIENT_ID=1556423149568925756
DISCORD_CLIENT_SECRET=4EGJqYLaEuoRZaw1faPplCSKXGX7lY8J

# Optional: turns on the /watch slash command.
# Developer Portal → General Information → Public Key
DISCORD_PUBLIC_KEY=

# Optional: a folder of movies on the machine running the server.
# Shows a Library tab in the activity. Example: D:\Movies  or  /home/me/Movies
MEDIA_DIR=

# Port for the server (the dev client proxies /api to it)
PORT=3001

# Let people join from a normal browser without Discord (local testing only).
# Open http://localhost:5173/?room=test in two tabs. Keep false when deployed.
ALLOW_GUESTS=false

# Allow links to private network addresses (e.g. a Jellyfin or file server on your LAN).
ALLOW_PRIVATE_URLS=false

# Encoding to try when a subtitle file isn't UTF-8 (windows-1256 = Arabic).
SUBTITLE_FALLBACK_ENCODING=windows-1256

# Optional: secret used to sign media links. Random on every start if empty.
MEDIA_SIGNING_SECRET=
